# CompanionOS 环境变量配置

# ==================== 后端服务 ====================
BACKEND_HOST=127.0.0.1
BACKEND_PORT=18080

# ==================== AI模型 ====================
# OpenAI兼容API（Hermes + Neuro-sama共用）
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# Hermes办公引擎
HERMES_API_BASE=http://localhost:11434/v1
HERMES_MODEL=gpt-4o

# Neuro-sama情感引擎
NEURO_API_BASE=http://localhost:11434/v1
NEURO_MODEL=gpt-4o

# ==================== 语音 ====================
# Edge TTS
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
VOICE_OUTPUT_DIR=/tmp/companion-os/voice

# ==================== 安全 ====================
# 操作审批：true=自动批准高风险操作，false=需手动批准
AUTO_APPROVE=false

# 数据加密密钥（生产环境务必更换）
COMPANION_OS_ENCRYPTION_KEY=default-dev-key

# ==================== MCP/A2A ====================
MCP_HOST=127.0.0.1
MCP_PORT=3456
A2A_HOST=127.0.0.1
A2A_PORT=3457
